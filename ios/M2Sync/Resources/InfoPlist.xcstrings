{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивает заезды с велокомпьютера по Bluetooth."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает вес, дату рождения и пол для расчёта калорий и проверяет, какие заезды уже есть в «Здоровье»."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет заезды как велотренировки с маршрутом, пульсом, каденсом, скоростью и активной энергией."
          }
        }
      }
    }
  },
  "version": "1.0"
}
